PORT=3000
NODE_ENV=development

DB_HOST=127.0.0.1
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=auto_repair_hub

# Required in all non-test environments (generate with):
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here

# Comma-separated browser origins allowed for CORS (same-origin needs no CORS)
ALLOWED_ORIGINS=http://localhost:3000

# Set true when serving over HTTPS (or behind TLS-terminating proxy)
COOKIE_SECURE=false

# Set true when behind a reverse proxy so rate limits use X-Forwarded-For
TRUST_PROXY=false

# Used only by npm run seed — never commit the real value
SEED_PASSWORD=change_me_on_first_seed
